APP_URL=http://localhost:42021
DATABASE_URL=file:./data/nooklet.db
# When running in Docker, the compose file overrides this to file:/app/data/nooklet.db
# so the database lives on the mounted `nooklet-data` volume.

# Optional. Docker host address and port to publish the app on. The loopback
# default prevents an unfinished setup from being exposed to the LAN. Set the
# address to 0.0.0.0 only when you intentionally want remote access.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=42021

# Required. Minimum 32 characters. Generate a unique value for each install:
# openssl rand -base64 48
AUTH_SECRET=

# Required to enable the first-admin web setup. Treat this like a temporary
# password, generate it independently, and remove it after creating the admin:
# openssl rand -base64 48
BOOTSTRAP_TOKEN=

# Strongly recommended. Dedicated key for encrypting stored service-connection
# secrets. Generate it independently from AUTH_SECRET. Falls back to
# AUTH_SECRET for backward compatibility when unset.
# SECRET_BOX_KEY=

# During key rotation, place superseded SECRET_BOX_KEY/AUTH_SECRET values here,
# separated by semicolons. Nooklet lazily re-encrypts secrets with the active
# key as they are read; remove old keys only after all credentials have rotated.
# SECRET_BOX_PREVIOUS_KEYS=

# Semicolon- or newline-separated directories the library scanner and file
# deletion workflows may access. Use container paths for Docker installs.
APPROVED_MEDIA_ROOTS=/media

# SABnzbd completed-download directories Nooklet may read and move files from
# when SABNZBD_PATH_MAPPINGS is not used. This boundary fails closed when empty.
APPROVED_DOWNLOAD_ROOTS=/downloads

# Working directory for the built-in downloader's incomplete and completed
# files. The local default is ./data/downloads. In Docker, use a container path;
# for a spacious host drive bind-mounted at /downloads, use:
# DOWNLOAD_ENGINE_DIR=/downloads/nooklet-engine
DOWNLOAD_ENGINE_DIR=./data/downloads

# Trust X-Forwarded-For/X-Real-IP only behind a reverse proxy that overwrites
# those headers. Leave false for direct connections.
TRUST_PROXY_HEADERS=false

# Prefer an exact semicolon-separated allowlist for LAN services. Entries are
# hostnames/IPs only (no scheme, port, path, CIDR, or wildcard).
PRIVATE_SERVICE_HOST_ALLOWLIST=

# Private/RFC1918 service targets are otherwise blocked by default. This broad
# override is intended only for trusted, single-user LAN deployments.
ALLOW_PRIVATE_SERVICE_HOSTS=false

# Optional. Maps SABnzbd-reported completed paths to paths Nooklet can read.
# Only needed when the path SAB reports does not resolve inside Nooklet's
# container. Format: <path-sab-reports>=<path-nooklet-reads>. Separate
# multiple mappings with semicolons or new lines.
# Example (SAB containerized at /sab-downloads, Nooklet bind-mounts the same
# host folder at /downloads):
# SABNZBD_PATH_MAPPINGS=/sab-downloads=/downloads

# Optional timeout for one background AI recommendation request, in
# milliseconds. The 30-minute default accommodates slower local and reasoning
# models; lower it only when the configured provider should fail faster.
AI_RECOMMENDATIONS_TIMEOUT_MS=1800000
