{
  "name": "nooklet",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node scripts/development-supervisor.mjs",
    "build": "next build && node scripts/build-worker.mjs",
    "postbuild": "node scripts/sanitize-standalone.mjs",
    "start": "node scripts/container-supervisor.mjs",
    "start:web": "next start",
    "start:worker": "node scripts/worker-supervisor.mjs",
    "test": "vitest run --environment node",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docs:dossier:check": "node scripts/validate-engineering-dossier.mjs && node scripts/validate-configurator.mjs",
    "docs:wiki:check": "node scripts/validate-wiki.mjs",
    "check": "npm run docs:dossier:check && npm run docs:wiki:check && npm run typecheck && npm run lint && npm test && npm run build",
    "db:backup": "node --env-file=.env scripts/backup-database.mjs",
    "account:recover": "node --env-file=.env scripts/recover-account.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.0",
    "lucide-react": "^1.24.0",
    "next": "^16.2.10",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "undici": "^7.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    },
    "esbuild": "$esbuild"
  }
}
