# syntax=docker/dockerfile:1.7

FROM node:26.8.1-bookworm-slim@sha256:367679cf9792759492a486e4aa4b421764d71a9546a6dae8aab81a99eb797b3e AS source

USER root
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates python3 \
  && rm -rf /var/lib/apt/lists/*

ARG BGUTIL_PROVIDER_COMMIT=fbe4ed47f3b63cf061f1158f18f74bcc90e54033
ARG BGUTIL_PROVIDER_SOURCE_SHA256=cbc8c2e54126ec38f4c2a278b3cab685d337cadc3e7f09762116e3b28be18b5f

RUN python3 -c "import hashlib, io, os, pathlib, sys, tarfile, urllib.request; commit, expected = sys.argv[1:]; data = urllib.request.urlopen(f'https://github.com/brianstanley/bgutil-ytdlp-pot-provider/archive/{commit}.tar.gz', timeout=60).read(); actual = hashlib.sha256(data).hexdigest(); actual == expected or sys.exit(f'provider source checksum mismatch: expected {expected}, got {actual}'); pathlib.Path('/tmp/bgutil-ytdlp-pot-provider-source.tar.gz').write_bytes(data); archive = tarfile.open(fileobj=io.BytesIO(data)); members = archive.getmembers(); all(not pathlib.PurePosixPath(member.name).is_absolute() and '..' not in pathlib.PurePosixPath(member.name).parts for member in members) or sys.exit('unsafe provider source archive'); archive.extractall('/src'); os.rename(f'/src/bgutil-ytdlp-pot-provider-{commit}', '/src/provider')" "${BGUTIL_PROVIDER_COMMIT}" "${BGUTIL_PROVIDER_SOURCE_SHA256}" \
  && python3 -c "import pathlib, sys, tarfile; source = pathlib.Path('/src/provider/server/src/session_manager.ts'); lines = source.read_text().splitlines(keepends=True); integrity_matches = [index for index, line in enumerate(lines) if 'Generated IntegrityToken:' in line]; len(integrity_matches) == 1 or sys.exit(f'expected one integrity-token log statement, found {len(integrity_matches)}'); integrity_index = integrity_matches[0]; integrity_start, integrity_end = integrity_index - 1, integrity_index + 1; lines[integrity_start].strip() == 'this.logger.debug(' and lines[integrity_end].strip() == ');' or sys.exit('unexpected integrity-token logger shape'); indentation = lines[integrity_start][:-len(lines[integrity_start].lstrip())]; lines[integrity_start:integrity_end + 1] = [indentation + 'this.logger.debug(\"Generated integrity token.\");\n']; po_matches = [index for index, line in enumerate(lines) if 'this.logger.log' in line and 'poToken:' in line]; len(po_matches) == 1 or sys.exit(f'expected one PO-token log statement, found {len(po_matches)}'); po_index = po_matches[0]; indentation = lines[po_index][:-len(lines[po_index].lstrip())]; lines[po_index] = indentation + 'this.logger.debug(\"Generated PO token.\");\n'; source.write_text(''.join(lines)); archive = tarfile.open('/tmp/bgutil-ytdlp-pot-provider-corresponding-source.tar.gz', 'w:gz'); archive.add('/src/provider', arcname='bgutil-ytdlp-pot-provider-fbe4ed47'); archive.close()" \
  && chown -R node:node /src/provider

USER node
WORKDIR /src/provider/server
RUN --mount=type=cache,target=/home/node/.npm,uid=1000,gid=1000 \
    npm ci --no-audit --no-fund
RUN npx tsc

FROM node:26.8.1-bookworm-slim@sha256:367679cf9792759492a486e4aa4b421764d71a9546a6dae8aab81a99eb797b3e AS runtime

ENV NODE_ENV=production
USER node
WORKDIR /app

COPY --from=source --chown=node:node /src/provider/server/package.json /src/provider/server/package-lock.json ./
RUN --mount=type=cache,target=/home/node/.npm,uid=1000,gid=1000 \
    npm ci --omit=dev --no-audit --no-fund

COPY --from=source --chown=node:node /src/provider/server/build ./build
COPY --from=source --chown=node:node /src/provider/LICENSE /licenses/bgutil-ytdlp-pot-provider-LICENSE
COPY --from=source --chown=node:node /tmp/bgutil-ytdlp-pot-provider-corresponding-source.tar.gz /licenses/bgutil-ytdlp-pot-provider-source.tar.gz

EXPOSE 4416
ENTRYPOINT ["/usr/local/bin/node", "build/main.js"]
